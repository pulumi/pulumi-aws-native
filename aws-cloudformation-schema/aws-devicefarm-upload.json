{
  "typeName" : "AWS::DeviceFarm::Upload",
  "description" : "Represents an app or test scripts upload in AWS Device Farm.",
  "properties" : {
    "Arn" : {
      "type" : "string",
      "description" : "The Amazon Resource Name (ARN) of the upload.",
      "minLength" : 32,
      "maxLength" : 1011,
      "pattern" : "^arn:.+:devicefarm:.+"
    },
    "ProjectArn" : {
      "type" : "string",
      "description" : "The ARN of the project for the upload.",
      "minLength" : 32,
      "maxLength" : 1011,
      "pattern" : "^arn:.+:devicefarm:.+"
    },
    "Name" : {
      "type" : "string",
      "description" : "The upload's file name.",
      "minLength" : 0,
      "maxLength" : 256
    },
    "Type" : {
      "type" : "string",
      "description" : "The upload's type.",
      "enum" : [ "ANDROID_APP", "IOS_APP", "WEB_APP", "EXTERNAL_DATA", "APPIUM_JAVA_JUNIT_TEST_PACKAGE", "APPIUM_JAVA_TESTNG_TEST_PACKAGE", "APPIUM_PYTHON_TEST_PACKAGE", "APPIUM_NODE_TEST_PACKAGE", "APPIUM_RUBY_TEST_PACKAGE", "APPIUM_WEB_JAVA_JUNIT_TEST_PACKAGE", "APPIUM_WEB_JAVA_TESTNG_TEST_PACKAGE", "APPIUM_WEB_PYTHON_TEST_PACKAGE", "APPIUM_WEB_NODE_TEST_PACKAGE", "APPIUM_WEB_RUBY_TEST_PACKAGE", "CALABASH_TEST_PACKAGE", "INSTRUMENTATION_TEST_PACKAGE", "UIAUTOMATION_TEST_PACKAGE", "UIAUTOMATOR_TEST_PACKAGE", "XCTEST_TEST_PACKAGE", "XCTEST_UI_TEST_PACKAGE", "APPIUM_JAVA_JUNIT_TEST_SPEC", "APPIUM_JAVA_TESTNG_TEST_SPEC", "APPIUM_PYTHON_TEST_SPEC", "APPIUM_NODE_TEST_SPEC", "APPIUM_RUBY_TEST_SPEC", "APPIUM_WEB_JAVA_JUNIT_TEST_SPEC", "APPIUM_WEB_JAVA_TESTNG_TEST_SPEC", "APPIUM_WEB_PYTHON_TEST_SPEC", "APPIUM_WEB_NODE_TEST_SPEC", "APPIUM_WEB_RUBY_TEST_SPEC", "INSTRUMENTATION_TEST_SPEC", "XCTEST_UI_TEST_SPEC" ]
    },
    "ContentType" : {
      "type" : "string",
      "description" : "The upload's content type (for example, application/octet-stream).",
      "minLength" : 0,
      "maxLength" : 64
    },
    "Status" : {
      "type" : "string",
      "description" : "The upload's status.",
      "enum" : [ "INITIALIZED", "PROCESSING", "SUCCEEDED", "FAILED" ]
    },
    "Category" : {
      "type" : "string",
      "description" : "The upload's category.",
      "enum" : [ "CURATED", "PRIVATE" ]
    },
    "Created" : {
      "type" : "string",
      "description" : "When the upload was created.",
      "format" : "date-time"
    }
  },
  "required" : [ "ProjectArn", "Name", "Type" ],
  "additionalProperties" : false,
  "readOnlyProperties" : [ "/properties/Arn", "/properties/Status", "/properties/Category", "/properties/Created" ],
  "createOnlyProperties" : [ "/properties/ProjectArn", "/properties/Name", "/properties/Type", "/properties/ContentType" ],
  "primaryIdentifier" : [ "/properties/Arn" ],
  "tagging" : {
    "taggable" : false
  },
  "handlers" : {
    "create" : {
      "permissions" : [ "devicefarm:CreateUpload", "devicefarm:GetUpload" ]
    },
    "read" : {
      "permissions" : [ "devicefarm:GetUpload" ]
    },
    "delete" : {
      "permissions" : [ "devicefarm:DeleteUpload", "devicefarm:GetUpload" ]
    },
    "list" : {
      "handlerSchema" : {
        "properties" : {
          "ProjectArn" : {
            "type" : "string",
            "description" : "The ARN of the project for which to list uploads.",
            "minLength" : 32,
            "maxLength" : 1011,
            "pattern" : "^arn:.+:devicefarm:.+"
          }
        },
        "required" : [ "ProjectArn" ]
      },
      "permissions" : [ "devicefarm:ListUploads" ]
    }
  }
}