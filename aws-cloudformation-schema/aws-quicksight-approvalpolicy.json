{
  "typeName" : "AWS::QuickSight::ApprovalPolicy",
  "description" : "Definition of the AWS::QuickSight::ApprovalPolicy Resource Type.",
  "definitions" : {
    "ApplicableTo" : {
      "type" : "object",
      "description" : "Scoping: who the policy applies to.",
      "properties" : {
        "Type" : {
          "$ref" : "#/definitions/ApplicableToType"
        },
        "GroupArns" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          },
          "minItems" : 1,
          "description" : "Required when type = GROUP. One or more group ARNs."
        }
      },
      "required" : [ "Type" ],
      "additionalProperties" : false
    },
    "ApplicableToType" : {
      "type" : "string",
      "enum" : [ "GROUP" ]
    },
    "AssetType" : {
      "type" : "string",
      "description" : "Asset types that can be governed by approval policies.",
      "enum" : [ "AGENT", "SPACE", "KNOWLEDGE_BASE", "FLOW" ]
    },
    "GovernedAction" : {
      "type" : "string",
      "description" : "Actions that can be governed by approval policies.",
      "enum" : [ "SHARE" ]
    }
  },
  "properties" : {
    "Actions" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/definitions/GovernedAction"
      },
      "maxItems" : 10,
      "minItems" : 1,
      "description" : "List of governed actions a policy applies to."
    },
    "ApplicableTo" : {
      "$ref" : "#/definitions/ApplicableTo"
    },
    "ApprovalGroups" : {
      "type" : "array",
      "items" : {
        "type" : "string"
      },
      "minItems" : 1,
      "description" : "List of approval group ARNs (e.g. QuickSight group ARNs).\nAt least one approval group is required."
    },
    "AssetTypes" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/definitions/AssetType"
      },
      "minItems" : 1,
      "description" : "List of asset types a policy applies to.\nAt least one asset type is required."
    },
    "CreatedAt" : {
      "type" : "string",
      "format" : "date-time"
    },
    "Description" : {
      "type" : "string",
      "maxLength" : 1024,
      "minLength" : 0
    },
    "Name" : {
      "type" : "string",
      "maxLength" : 256,
      "minLength" : 1
    },
    "PolicyArn" : {
      "type" : "string"
    },
    "PolicyId" : {
      "type" : "string",
      "maxLength" : 64,
      "minLength" : 1,
      "pattern" : "^[a-zA-Z0-9\\-_]+$"
    },
    "UpdatedAt" : {
      "type" : "string",
      "format" : "date-time"
    }
  },
  "required" : [ "PolicyId", "Name", "Actions", "AssetTypes", "ApplicableTo", "ApprovalGroups" ],
  "readOnlyProperties" : [ "/properties/CreatedAt", "/properties/PolicyArn", "/properties/UpdatedAt" ],
  "createOnlyProperties" : [ "/properties/PolicyId" ],
  "primaryIdentifier" : [ "/properties/PolicyId" ],
  "handlers" : {
    "create" : {
      "permissions" : [ "quicksight:CreateApprovalPolicy", "quicksight:DescribeApprovalPolicy" ]
    },
    "read" : {
      "permissions" : [ "quicksight:DescribeApprovalPolicy" ]
    },
    "update" : {
      "permissions" : [ "quicksight:UpdateApprovalPolicy", "quicksight:DescribeApprovalPolicy" ]
    },
    "delete" : {
      "permissions" : [ "quicksight:DeleteApprovalPolicy", "quicksight:DescribeApprovalPolicy" ]
    },
    "list" : {
      "permissions" : [ "quicksight:ListApprovalPolicies" ]
    }
  },
  "additionalProperties" : false,
  "tagging" : {
    "taggable" : false,
    "tagOnCreate" : false,
    "tagUpdatable" : false,
    "cloudFormationSystemTags" : false
  }
}